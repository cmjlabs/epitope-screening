include requirements.txt requirements-build.txt launch.py EpitopeScreening.spec start_windows.cmd start_linux.sh THIRD_PARTY.md
include requirements-local.txt setup_local_linux.sh start_local_linux.sh
recursive-include docs *.md
recursive-include examples *.json *.csv *.fasta
recursive-include tests *.py
recursive-include tests/fixtures *.json
recursive-include scripts *.py

include launch_web.py EpitopeScreeningWeb.spec start_web_linux.sh
recursive-include epitope_screening/web *.html *.css *.js *.txt *.fasta *.csv
